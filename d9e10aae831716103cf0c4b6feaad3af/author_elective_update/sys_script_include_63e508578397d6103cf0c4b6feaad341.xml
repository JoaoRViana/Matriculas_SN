        <script><![CDATA[var AjaxUtils = Class.create();
AjaxUtils.prototype = Object.extendsObject(global.AbstractAjaxProcessor, {
	valDuplicate:function(){
		var courseId = this.getParameter("sysparam_course_sys_id");
		var date = this.getParameter("sysparam_date");
		var realDate = date.split('/');
		realDate = realDate[2]+'-'+realDate[1]+'-'+realDate[0];
		var grTraining = new GlideRecord("x_1593175_agenda_0_training");
		grTraining.addQuery("course",courseId);
		grTraining.addEncodedQuery("dayON"+realDate+"@javascript:gs.dateGenerate"+"('"+realDate+"','start')@javascript:gs.dateGenerate"+"('"+realDate+"','end')");
		grTraining.query();
		var arrTraining=[];
		while(grTraining.next()){
			return 'true';
		}
		return 'false';
	},
	valStudent: function(){
		var courseId = this.getParameter("sysparam_course_sys_id");
		var training = this.getParameter("sysparam_training");
	},
    type: 'AjaxUtils'
});]]></script>
