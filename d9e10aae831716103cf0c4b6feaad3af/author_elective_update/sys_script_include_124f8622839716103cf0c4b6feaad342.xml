        <script><![CDATA[var checkDate = Class.create();
checkDate.prototype = Object.extendsObject(global.AbstractAjaxProcessor, {
	checkDateAndCourse:function(){
		var day = this.getParameter('day');
        var course = this.getParameter('course');
		var grTraining = new GlideRecord('x_1593175_agenda_0_training');
		grTraining.addQuery("day",day);
		grTraining.addQuery("course",course);
		grTraining.query();
		var arr=[];
		while(grTraining.next()){
			arr.push(grTraining);
		}
		return arr.length>1;
	},
    type: 'checkDate'
});]]></script>
